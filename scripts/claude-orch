#!/usr/bin/env bash
# claude-orch — PATH shim: workspace pins + multi-account failover via pick-account.cjs
# CLAUDE_ACCOUNTS_ORCH
set -euo pipefail

POLICY="${CLAUDE_ACCOUNTS_POLICY:-$HOME/.config/claude-accounts/policy.json}"
REAL="${CLAUDE_ACCOUNTS_REAL:-}"
ROOT="$(cd "$(dirname "$0")" && pwd)"
# When installed to ~/bin, lib lives next to install source or under repo
PICK=""
for c in \
  "$ROOT/pick-account.cjs" \
  "$HOME/bin/claude-accounts-lib/pick-account.cjs" \
  "$HOME/bin/pick-account.cjs" \
  "$HOME/projects/claude-accounts/scripts/pick-account.cjs"
do
  if [ -f "$c" ]; then PICK="$c"; break; fi
done

resolve_real() {
  if [ -n "$REAL" ] && [ -x "$REAL" ]; then
    echo "$REAL"
    return
  fi
  local p
  while IFS= read -r p; do
    case "$p" in
      "$HOME/bin/claude"|*/claude-orch) continue ;;
      /mnt/c/*|*/Windows/*) continue ;;
    esac
    if [ -x "$p" ] && ! grep -q 'CLAUDE_ACCOUNTS_ORCH' "$p" 2>/dev/null; then
      echo "$p"
      return
    fi
  done < <(type -a claude 2>/dev/null | sed -n 's/.* is //p; s/.* is hashed (\(.*\))/\1/p' || true)
  for p in "$HOME/.npm-global/bin/claude" "$HOME/.local/bin/claude" /usr/local/bin/claude; do
    if [ -x "$p" ] && ! grep -q 'CLAUDE_ACCOUNTS_ORCH' "$p" 2>/dev/null; then
      echo "$p"
      return
    fi
  done
  echo "claude-orch: could not find real claude binary" >&2
  exit 127
}

pick_dir() {
  if [ -n "${CLAUDE_ORCH_STICKY_DIR:-}" ] && [ -d "${CLAUDE_ORCH_STICKY_DIR}" ]; then
    echo "$CLAUDE_ORCH_STICKY_DIR"
    return
  fi
  if [ -n "$PICK" ] && [ -f "$PICK" ]; then
    node "$PICK" "$POLICY" "$(pwd -P 2>/dev/null || pwd)" || true
    return
  fi
  # Fallback: honor env only
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ -d "${CLAUDE_CONFIG_DIR}" ]; then
    echo "$CLAUDE_CONFIG_DIR"
  fi
}

REAL_BIN="$(resolve_real)"
DIR="$(pick_dir || true)"

export CLAUDE_ACCOUNTS_ORCH=1

if [ -n "${DIR:-}" ]; then
  export CLAUDE_CONFIG_DIR="$DIR"
  if [ "${CLAUDE_ORCH_STICKY:-}" = "1" ]; then
    export CLAUDE_ORCH_STICKY_DIR="$DIR"
  fi
fi

exec "$REAL_BIN" "$@"
